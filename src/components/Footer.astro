---
import { SITE_AUTHOR, SOCIAL_LINKS } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="inner meta">
		<div class="row">
			<span>&copy; {year} {SITE_AUTHOR}</span>
			<nav aria-label="Altrove">
				{
					SOCIAL_LINKS.map(({ label, href, rel }) => (
						<a href={href} rel={['noopener', rel].filter(Boolean).join(' ')} target="_blank">
							{label}
						</a>
					))
				}
				<a href="/rss.xml">RSS</a>
			</nav>
		</div>
		<div class="row legal">
			<span>Blog personale, senza fini commerciali</span>
			<nav aria-label="Note legali">
				<a href="/privacy/">Privacy</a>
				<a href="/cookie/">Cookie</a>
				<button type="button" data-cookie-prefs>Preferenze cookie</button>
			</nav>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--faint);
	}
	.inner {
		max-width: calc(var(--measure) + 2 * var(--gutter));
		margin: 0 auto;
		padding: 1.75rem var(--gutter) 2.5rem;
	}
	.row {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
	}
	.legal {
		margin-top: 0.9rem;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
	}
	a {
		text-decoration: none;
	}
	button {
		padding: 0;
		font: inherit;
		color: inherit;
		background: none;
		border: 0;
		cursor: pointer;
		transition: color 0.15s ease;
	}
	button:hover {
		color: var(--accent);
	}
</style>

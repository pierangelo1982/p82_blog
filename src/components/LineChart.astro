---
/**
 * Grafico a linee di funzioni, generato in fase di build.
 * - Le curve sono SVG inline (pochi KB, nitide a ogni zoom, colori dal tema chiaro/scuro).
 * - Testi, tick, punti ed etichette sono HTML posizionato in percentuale:
 *   restano leggibili anche su schermi piccoli e possono contenere formule KaTeX.
 * - Un piccolo script aggiunge mirino e tooltip (mouse, touch e frecce da tastiera).
 * - La tabella dei dati rende i valori accessibili anche senza grafico.
 */
import type { ChartColor, ChartConfig, ChartDash, Place } from '../lib/chart';
import { tex } from '../lib/tex';

type Props = ChartConfig;
const { title, caption, x, y, series, step, table, marks = [], notes = [], guides = [], aspect = 16 / 10 } =
	Astro.props;

const W = 1000;
const H = Math.round(W / aspect);
const sx = (v: number) => ((v - x.min) / (x.max - x.min)) * W;
const sy = (v: number) => (1 - (v - y.min) / (y.max - y.min)) * H;
const px = (v: number) => `${(((v - x.min) / (x.max - x.min)) * 100).toFixed(3)}%`;
const py = (v: number) => `${((1 - (v - y.min) / (y.max - y.min)) * 100).toFixed(3)}%`;
const r1 = (v: number) => Math.round(v * 10) / 10;
const r2 = (v: number) => Math.round(v * 100) / 100;

/** Ramer–Douglas–Peucker: toglie i punti che si discostano meno di `eps` dalla linea. */
function simplify(pts: [number, number][], eps: number): [number, number][] {
	if (pts.length < 3) return pts;
	const [ax, ay] = pts[0];
	const [bx, by] = pts[pts.length - 1];
	const len = Math.hypot(bx - ax, by - ay) || 1;
	let max = 0;
	let idx = 0;
	for (let i = 1; i < pts.length - 1; i++) {
		const [px, py] = pts[i];
		const dist = Math.abs((by - ay) * px - (bx - ax) * py + bx * ay - by * ax) / len;
		if (dist > max) {
			max = dist;
			idx = i;
		}
	}
	if (max <= eps) return [pts[0], pts[pts.length - 1]];
	return [...simplify(pts.slice(0, idx + 1), eps).slice(0, -1), ...simplify(pts.slice(idx), eps)];
}

const fmt = (v: number, decimals = 0) =>
	v.toLocaleString('it-IT', { minimumFractionDigits: decimals, maximumFractionDigits: decimals });

const colorVar = (c: ChartColor) => (c === 'neutral' ? 'var(--muted)' : `var(--chart-${c})`);
const dashArray: Record<ChartDash, string | undefined> = {
	solid: undefined,
	dash: '8 5',
	dot: '0.1 5',
	dashdot: '10 4 0.1 4',
};

// Curve: campionamento fitto per il disegno
const paths = series.map((s) => {
	const [a, b] = s.domain ?? [x.min, x.max];
	const n = 400;
	const pts: [number, number][] = [];
	for (let i = 0; i <= n; i++) {
		const xv = a + ((b - a) * i) / n;
		const yv = s.fn(xv);
		if (Number.isFinite(yv)) pts.push([sx(xv), sy(yv)]);
	}
	// tolleranza 0,4 unità su 1000 di larghezza: invisibile a qualsiasi dimensione
	return `M${simplify(pts, 0.4)
		.map(([px, py]) => `${r1(px)},${r1(py)}`)
		.join('L')}`;
});

const inDomain = (s: (typeof series)[number], v: number) => {
	const [a, b] = s.domain ?? [x.min, x.max];
	return v >= a - 1e-9 && v <= b + 1e-9;
};

// Griglia regolare per tooltip/tastiera
const xs: number[] = [];
for (let v = x.min; v <= x.max + step / 2; v += step) xs.push(Math.round(v * 1e6) / 1e6);
const tipData = {
	xs,
	x: { decimals: x.decimals ?? 0, unit: x.unit ?? '', prefix: x.prefix ?? '' },
	y: { decimals: y.decimals ?? 1, unit: y.unit ?? '', min: y.min, max: y.max },
	series: series.map((s) => {
		return {
			name: s.plain,
			color: colorVar(s.color),
			dash: s.dash ?? 'solid',
			ys: xs.map((v) => {
				const yv = inDomain(s, v) ? s.fn(v) : NaN;
				return Number.isFinite(yv) ? Math.round(yv * 1e4) / 1e4 : null;
			}),
		};
	}),
};

// Tabella dei dati
const tableRows = table.map((v) => ({
	x: fmt(v, x.decimals ?? 0),
	ys: series.map((s) => {
		const yv = inDomain(s, v) ? s.fn(v) : NaN;
		return Number.isFinite(yv) ? fmt(yv, y.decimals ?? 1) : '–';
	}),
}));

const zeroInside = y.min < 0 && y.max > 0;
const baseline = zeroInside ? 0 : y.min;

const ariaLabel = `${title}. Asse orizzontale: ${x.label.replace(/\$/g, '')}; asse verticale: ${y.label.replace(/\$/g, '')}. Usa le frecce per leggere i valori.`;
const legend = series.length > 1;
const placeClass = (p: Place = 'n') => `at-${p}`;
---

<figure class="chart" data-chart>
	{
		legend && (
			<ul class="chart-legend">
				{series.map((s) => (
					<li>
						<svg class="key" viewBox="0 0 26 8" aria-hidden="true">
							<line
								x1="1"
								y1="4"
								x2="25"
								y2="4"
								stroke={colorVar(s.color)}
								stroke-dasharray={dashArray[s.dash ?? 'solid']}
							/>
						</svg>
						<span set:html={tex(s.name)} />
					</li>
				))}
			</ul>
		)
	}

	<div class="chart-ylabel" set:html={tex(y.label)} />

	<div class="chart-frame">
		<div
			class="chart-plot"
			style={`--ar:${aspect}`}
			tabindex="0"
			role="img"
			aria-label={ariaLabel}
		>
			<svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
				<g class="grid">
					{y.ticks.map((t) => <line x1="0" x2={W} y1={r2(sy(t))} y2={r2(sy(t))} />)}
				</g>
				<line class="axis" x1="0" x2={W} y1={r2(sy(baseline))} y2={r2(sy(baseline))} />
				<g class="guides">
					{guides.map((g) => <line x1={r2(sx(g.x))} x2={r2(sx(g.x))} y1={r2(sy(g.y0))} y2={r2(sy(g.y1))} />)}
				</g>
				<g class="curves">
					{
						series.map((s, i) => (
							<path
								d={paths[i]}
								stroke={colorVar(s.color)}
								stroke-dasharray={dashArray[s.dash ?? 'solid']}
							/>
						))
					}
				</g>
			</svg>

			{
				y.ticks.map((t) => (
					<span class="tick y" style={`top:${py(t)}`} aria-hidden="true">
						{fmt(t, y.tickDecimals ?? 0)}
					</span>
				))
			}
			{
				x.ticks.map((t) => (
					<span class="tick x" style={`left:${px(t)}`} aria-hidden="true">
						{fmt(t, x.tickDecimals ?? 0)}
					</span>
				))
			}

			{
				series.map(
					(s) =>
						s.label && (
							<span
								class:list={['label', placeClass(s.label.place)]}
								style={`left:${px(s.label.x)};top:${py(s.fn(s.label.x))}`}
								aria-hidden="true"
								set:html={tex(s.label.text ?? s.name, { mathml: false })}
							/>
						),
				)
			}
			{
				marks.map((m) => (
					<>
						<span class:list={['mark', { hollow: m.hollow }]} style={`left:${px(m.x)};top:${py(m.y)}`} aria-hidden="true" />
						{m.label && (
							<span
								class:list={['label', placeClass(m.place)]}
								style={`left:${px(m.x)};top:${py(m.y)}`}
								aria-hidden="true"
								set:html={tex(m.label, { mathml: false })}
							/>
						)}
					</>
				))
			}
			{
				notes.map((n) => (
					<span
						class:list={['note', placeClass(n.place ?? 'c')]}
						style={`left:${px(n.x)};top:${py(n.y)}`}
						aria-hidden="true"
						set:html={tex(n.text, { mathml: false })}
					/>
				))
			}

			<div class="crosshair" hidden></div>
			<div class="tooltip" hidden aria-live="polite"></div>
		</div>
	</div>

	<div class="chart-xlabel" set:html={tex(x.label)} />

	<figcaption set:html={tex(caption)} />

	<details class="chart-table">
		<summary>Tabella dei valori</summary>
		<table>
			<thead>
				<tr>
					<th scope="col">{x.prefix ? x.prefix.replace(/\s*=\s*$/, '') : 'x'}{x.unit && ` (${x.unit})`}</th>
					{series.map((s) => <th scope="col">{s.plain}</th>)}
				</tr>
			</thead>
			<tbody>
				{
					tableRows.map((row) => (
						<tr>
							<th scope="row">{row.x}</th>
							{row.ys.map((v) => (
								<td>{v}</td>
							))}
						</tr>
					))
				}
			</tbody>
		</table>
	</details>

	<script type="application/json" set:html={JSON.stringify(tipData)} />
</figure>

<script>
	interface TipData {
		xs: number[];
		x: { decimals: number; unit: string; prefix: string };
		y: { decimals: number; unit: string; min: number; max: number };
		series: { name: string; color: string; dash: string; ys: (number | null)[] }[];
	}

	const DASH: Record<string, string> = { solid: '', dash: '4 3', dot: '0.1 3', dashdot: '5 2 0.1 2' };
	const SVG = 'http://www.w3.org/2000/svg';

	function setup(fig: HTMLElement) {
		const plot = fig.querySelector<HTMLElement>('.chart-plot');
		const json = fig.querySelector('script[type="application/json"]');
		const hair = fig.querySelector<HTMLElement>('.crosshair');
		const tip = fig.querySelector<HTMLElement>('.tooltip');
		if (!plot || !json || !hair || !tip) return;
		const data: TipData = JSON.parse(json.textContent || '{}');
		const { xs } = data;
		const x0 = xs[0];
		const x1 = xs[xs.length - 1];
		const nf = (d: number) => new Intl.NumberFormat('it-IT', { minimumFractionDigits: d, maximumFractionDigits: d });
		const fx = nf(data.x.decimals);
		const fy = nf(data.y.decimals);

		// Righe del tooltip e punti sulle curve, creati una volta sola (testo via textContent)
		const head = document.createElement('div');
		head.className = 'tip-head';
		tip.append(head);
		const rows = data.series.map((s) => {
			const row = document.createElement('div');
			row.className = 'tip-row';
			const key = document.createElementNS(SVG, 'svg');
			key.setAttribute('viewBox', '0 0 14 6');
			key.setAttribute('class', 'tip-key');
			const ln = document.createElementNS(SVG, 'line');
			ln.setAttribute('x1', '1');
			ln.setAttribute('x2', '13');
			ln.setAttribute('y1', '3');
			ln.setAttribute('y2', '3');
			ln.setAttribute('stroke', s.color);
			if (DASH[s.dash]) ln.setAttribute('stroke-dasharray', DASH[s.dash]);
			key.append(ln);
			const val = document.createElement('strong');
			const name = document.createElement('span');
			name.textContent = s.name;
			row.append(key, val, name);
			tip.append(row);
			const dot = document.createElement('span');
			dot.className = 'probe';
			dot.style.background = s.color;
			dot.hidden = true;
			plot.append(dot);
			return { row, val, dot };
		});

		let current = -1;

		function show(i: number) {
			current = Math.max(0, Math.min(xs.length - 1, i));
			const xv = xs[current];
			const left = ((xv - x0) / (x1 - x0)) * 100;
			hair!.hidden = false;
			tip!.hidden = false;
			hair!.style.left = `${left}%`;
			head.textContent = `${data.x.prefix}${fx.format(xv)}${data.x.unit ? ' ' + data.x.unit : ''}`;
			data.series.forEach((s, k) => {
				const yv = s.ys[current];
				const { row, val, dot } = rows[k];
				row.hidden = yv === null;
				dot.hidden = true;
				if (yv === null) return;
				val.textContent = `${fy.format(yv)}${data.y.unit ? ' ' + data.y.unit : ''}`;
				const top = (1 - (yv - data.y.min) / (data.y.max - data.y.min)) * 100;
				if (top >= 0 && top <= 100) {
					dot.hidden = false;
					dot.style.left = `${left}%`;
					dot.style.top = `${top}%`;
				}
			});
			tip!.classList.toggle('flip', left > 55);
			tip!.style.left = `${left}%`;
		}

		function hide() {
			hair!.hidden = true;
			tip!.hidden = true;
			rows.forEach((r) => (r.dot.hidden = true));
		}

		function fromPointer(e: PointerEvent) {
			const rect = plot!.getBoundingClientRect();
			const t = (e.clientX - rect.left) / rect.width;
			const xv = x0 + t * (x1 - x0);
			show(Math.round((xv - x0) / ((x1 - x0) / (xs.length - 1))));
		}

		plot.addEventListener('pointermove', fromPointer);
		plot.addEventListener('pointerdown', fromPointer);
		plot.addEventListener('pointerleave', (e) => {
			if (e.pointerType === 'mouse') hide();
		});
		plot.addEventListener('focus', () => show(current < 0 ? Math.floor(xs.length / 2) : current));
		plot.addEventListener('blur', hide);
		plot.addEventListener('keydown', (e) => {
			const big = Math.max(1, Math.round(xs.length / 12));
			const moves: Record<string, number> = {
				ArrowRight: 1,
				ArrowLeft: -1,
				ArrowUp: big,
				ArrowDown: -big,
				PageUp: big,
				PageDown: -big,
			};
			if (e.key === 'Home') show(0);
			else if (e.key === 'End') show(xs.length - 1);
			else if (e.key === 'Escape') hide();
			else if (e.key in moves) show(current + moves[e.key] * (e.shiftKey ? 5 : 1));
			else return;
			e.preventDefault();
		});
	}

	document.querySelectorAll<HTMLElement>('[data-chart]').forEach(setup);
</script>

<style>
	.chart {
		margin: 2.75em 0 !important;
		font-family: var(--sans);
		font-size: 0.8125rem;
		line-height: 1.4;
		color: var(--muted);
		hyphens: manual;
	}
	.chart :global(.katex) {
		font-size: 1.05em;
	}

	/* Legenda */
	.chart-legend {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1.25rem;
		list-style: none;
		margin: 0 0 1rem;
		padding: 0;
		color: var(--text);
	}
	.chart-legend li {
		margin: 0 !important;
		display: flex;
		align-items: center;
		gap: 0.45rem;
	}
	.key {
		width: 26px;
		height: 8px;
		flex: none;
		overflow: visible;
	}
	.key line {
		stroke-width: 2.25;
		stroke-linecap: round;
	}

	.chart-ylabel {
		margin-bottom: 0.6rem;
	}
	.chart-xlabel {
		margin-top: 0.15rem;
		text-align: right;
	}

	/* Area del grafico: margine a sinistra e sotto per i tick */
	.chart-frame {
		padding: 0.5rem 1rem 1.6rem 2.6rem;
	}
	.chart-plot {
		position: relative;
		aspect-ratio: var(--ar);
		cursor: crosshair;
		touch-action: pan-y;
		outline: none;
	}
	.chart-plot:focus-visible {
		box-shadow: 0 0 0 2px var(--bg), 0 0 0 4px var(--accent);
		border-radius: 2px;
	}
	@media (max-width: 34rem) {
		.chart-plot {
			aspect-ratio: 4 / 3.4;
		}
		.chart-frame {
			padding-left: 2.2rem;
			padding-right: 0.85rem;
		}
	}
	.chart-plot > svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: hidden;
	}
	.grid line {
		stroke: var(--chart-grid);
		stroke-width: 1;
		vector-effect: non-scaling-stroke;
	}
	.axis {
		stroke: var(--chart-axis);
		stroke-width: 1;
		vector-effect: non-scaling-stroke;
	}
	.guides line {
		stroke: var(--muted);
		stroke-width: 1;
		stroke-opacity: 0.6;
		vector-effect: non-scaling-stroke;
	}
	.curves path {
		fill: none;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
		vector-effect: non-scaling-stroke;
	}

	.tick {
		position: absolute;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		pointer-events: none;
	}
	.tick.y {
		left: -0.55rem;
		transform: translate(-100%, -50%);
	}
	.tick.x {
		top: calc(100% + 0.45rem);
		transform: translateX(-50%);
	}

	/* Etichette dirette, note e punti */
	.label,
	.note {
		position: absolute;
		white-space: nowrap;
		pointer-events: none;
		color: var(--text);
	}
	.note {
		color: var(--muted);
		text-align: center;
		white-space: normal;
		width: max-content;
		max-width: 14rem;
	}
	.at-n { transform: translate(-50%, calc(-100% - 0.5rem)); }
	.at-s { transform: translate(-50%, 0.5rem); }
	.at-e { transform: translate(0.6rem, -50%); }
	.at-w { transform: translate(calc(-100% - 0.6rem), -50%); }
	.at-ne { transform: translate(0.35rem, calc(-100% - 0.35rem)); }
	.at-nw { transform: translate(calc(-100% - 0.35rem), calc(-100% - 0.35rem)); }
	.at-se { transform: translate(0.35rem, 0.35rem); }
	.at-sw { transform: translate(calc(-100% - 0.35rem), 0.35rem); }
	.at-c { transform: translate(-50%, -50%); }

	.mark,
	:global(.chart .probe) {
		position: absolute;
		width: 9px;
		height: 9px;
		border-radius: 50%;
		transform: translate(-50%, -50%);
		pointer-events: none;
	}
	.mark {
		background: var(--text);
		box-shadow: 0 0 0 2px var(--bg);
	}
	.mark.hollow {
		background: var(--bg);
		border: 2px solid var(--text);
		box-shadow: none;
	}
	:global(.chart .probe) {
		box-shadow: 0 0 0 2px var(--bg);
		z-index: 2;
	}

	/* Mirino e tooltip */
	.crosshair {
		position: absolute;
		top: 0;
		bottom: 0;
		width: 1px;
		background: var(--muted);
		opacity: 0.45;
		pointer-events: none;
	}
	.tooltip {
		position: absolute;
		top: 0;
		z-index: 3;
		transform: translateX(0.75rem);
		min-width: 9rem;
		padding: 0.5rem 0.65rem;
		background: var(--bg);
		border: 1px solid var(--faint);
		border-radius: 4px;
		box-shadow: 0 6px 20px -8px rgba(0, 0, 0, 0.25);
		pointer-events: none;
		font-size: 0.75rem;
		color: var(--muted);
	}
	.tooltip.flip {
		transform: translateX(calc(-100% - 0.75rem));
	}
	.crosshair[hidden],
	.tooltip[hidden],
	:global(.chart [hidden]) {
		display: none;
	}
	:global(.chart .tip-head) {
		color: var(--text);
		font-weight: 600;
		margin-bottom: 0.3rem;
	}
	:global(.chart .tip-row) {
		display: grid;
		grid-template-columns: 14px auto 1fr;
		align-items: center;
		gap: 0.45rem;
		white-space: nowrap;
	}
	:global(.chart .tip-row strong) {
		color: var(--text);
		font-variant-numeric: tabular-nums;
		font-weight: 600;
	}
	:global(.chart .tip-key) {
		width: 14px;
		height: 6px;
		overflow: visible;
	}
	:global(.chart .tip-key line) {
		stroke-width: 2;
		stroke-linecap: round;
	}

	figcaption {
		margin-top: 1rem !important;
		text-align: left !important;
		line-height: 1.55;
	}

	.chart-table {
		margin-top: 0.75rem;
	}
	.chart-table summary {
		cursor: pointer;
		width: max-content;
		color: var(--muted);
	}
	.chart-table summary:hover {
		color: var(--text);
	}
	.chart-table table {
		margin-top: 0.75rem;
		font-variant-numeric: tabular-nums;
	}
	.chart-table td,
	.chart-table th[scope='row'] {
		text-align: right !important;
	}
	.chart-table th[scope='col']:not(:first-child) {
		text-align: right !important;
	}
</style>

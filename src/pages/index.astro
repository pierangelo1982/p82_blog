---
import PostList from '../components/PostList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Base from '../layouts/Base.astro';
import { getPosts } from '../lib/posts';

const LATEST = 6;
const posts = await getPosts();
const latest = posts.slice(0, LATEST);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="intro">
		<p>{SITE_DESCRIPTION}</p>
	</section>

	<section aria-labelledby="ultimi">
		<h2 id="ultimi" class="eyebrow">Ultimi articoli</h2>
		<PostList posts={latest} />
		{
			posts.length > LATEST && (
				<p class="all meta">
					<a href="/blog/">Tutti gli articoli ({posts.length}) →</a>
				</p>
			)
		}
	</section>
</Base>

<style>
	.intro {
		margin-bottom: 3.5rem;
	}
	.intro p {
		margin: 0;
		font-size: clamp(1.35rem, 1.1rem + 1vw, 1.65rem);
		line-height: 1.4;
		letter-spacing: -0.01em;
		text-wrap: balance;
	}
	.all {
		margin-top: 3rem;
	}
	.all a {
		text-decoration: none;
	}
</style>

---
import { SITE_AUTHOR, SOCIAL_LINKS } from '../consts';
import Base from '../layouts/Base.astro';
---

<Base title="Chi sono" description={`Chi c'è dietro questo blog: ${SITE_AUTHOR}.`}>
	<h1>Chi sono</h1>
	<div class="prose">
		<!-- TODO: scrivere una breve presentazione -->
		<p>
			Sono {SITE_AUTHOR}, programmatore. Qui scrivo di libri che ho letto, soprattutto di storia, e di
			quello che incontro facendo software.
		</p>
		<p>
			Mi trovi anche su
			{
				SOCIAL_LINKS.map(({ label, href, rel }, i) => (
					<>
						<a href={href} rel={['noopener', rel].filter(Boolean).join(' ')}>
							{label}
						</a>
						{i < SOCIAL_LINKS.length - 2 ? ', ' : i === SOCIAL_LINKS.length - 2 ? ' e ' : ''}
					</>
				))
			}. Per seguire il blog c'è il <a href="/rss.xml">feed RSS</a>.
		</p>
	</div>
</Base>

<style>
	h1 {
		font-size: clamp(2rem, 1.5rem + 2.2vw, 2.75rem);
		margin-bottom: 2rem;
	}
</style>

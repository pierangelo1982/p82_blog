---
import PostList from '../../components/PostList.astro';
import Base from '../../layouts/Base.astro';
import { getPosts, groupByYear } from '../../lib/posts';

const posts = await getPosts();
const years = groupByYear(posts);
---

<Base title="Articoli" description={`Tutti gli articoli (${posts.length}), dal più recente.`}>
	<h1>Articoli</h1>
	{
		years.map(([year, items]) => (
			<section class="year" aria-labelledby={`y${year}`}>
				<h2 id={`y${year}`} class="eyebrow">
					{year}
				</h2>
				<PostList posts={items} excerpt={false} shortDate />
			</section>
		))
	}
</Base>

<style>
	h1 {
		font-size: clamp(2rem, 1.5rem + 2.2vw, 2.75rem);
		margin-bottom: 3rem;
	}
	.year + .year {
		margin-top: 3.5rem;
	}
</style>

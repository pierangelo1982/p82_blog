---
import 'katex/dist/katex.min.css';
import { Image } from 'astro:assets';
import FormattedDate from '../components/FormattedDate.astro';
import type { Post } from '../lib/posts';
import Base from './Base.astro';

type Props = Post['data'] & {
	description: string;
	/** Sottotitolo mostrato sotto il titolo (la descrizione scritta nel frontmatter). */
	subtitle?: string;
	readingTime?: number;
	prev?: Post;
	next?: Post;
};

const { title, description, subtitle, pubDate, updatedDate, heroImage, readingTime, prev, next } =
	Astro.props;
const isPortrait = heroImage ? heroImage.height > heroImage.width : false;
---

<Base title={title} description={description} image={heroImage} type="article" publishedTime={pubDate}>
	<article>
		<header class="post-header">
			<p class="meta">
				<FormattedDate date={pubDate} />
				{readingTime && <span aria-hidden="true"> · </span>}
				{readingTime && <span>{readingTime} min di lettura</span>}
			</p>
			<h1>{title}</h1>
			{subtitle && <p class="subtitle">{subtitle}</p>}
			{
				updatedDate && (
					<p class="meta updated">
						Aggiornato il <FormattedDate date={updatedDate} />
					</p>
				)
			}
		</header>

		{
			heroImage && (
				<figure class:list={['cover', { portrait: isPortrait }]}>
					<Image
						src={heroImage}
						alt=""
						widths={isPortrait ? [320, 640] : [640, 960, 1280]}
						sizes={isPortrait ? '(max-width: 40rem) 60vw, 320px' : '(max-width: 42rem) 100vw, 640px'}
						loading="eager"
						fetchpriority="high"
					/>
				</figure>
			)
		}

		<div class="prose">
			<slot />
		</div>
	</article>

	{
		(prev || next) && (
			<nav class="pager" aria-label="Altri articoli">
				{prev ? (
					<a href={`/blog/${prev.id}/`} class="prev">
						<span class="meta">← Precedente</span>
						<span class="t">{prev.data.title}</span>
					</a>
				) : (
					<span />
				)}
				{next && (
					<a href={`/blog/${next.id}/`} class="next">
						<span class="meta">Successivo →</span>
						<span class="t">{next.data.title}</span>
					</a>
				)}
			</nav>
		)
	}
</Base>

<style>
	.post-header {
		margin-bottom: 2.5rem;
	}
	.post-header .meta {
		margin: 0 0 0.9rem;
	}
	h1 {
		font-size: clamp(2rem, 1.5rem + 2.2vw, 2.75rem);
		line-height: 1.12;
		letter-spacing: -0.022em;
	}
	.subtitle {
		margin: 1rem 0 0;
		font-size: 1.15em;
		line-height: 1.5;
		font-style: italic;
		color: var(--muted);
		text-wrap: pretty;
	}
	.updated {
		margin-top: 0.9rem !important;
	}
	.cover {
		margin: 0 0 2.75rem;
	}
	.cover img {
		display: block;
		width: 100%;
		border-radius: 3px;
	}
	.cover.portrait img {
		width: auto;
		max-width: min(60%, 20rem);
		margin: 0 auto;
		box-shadow:
			0 1px 2px rgba(0, 0, 0, 0.08),
			0 12px 32px -12px rgba(0, 0, 0, 0.35);
	}
	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
		margin-top: 4.5rem;
		padding-top: 2rem;
		border-top: 1px solid var(--faint);
	}
	.pager a {
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		text-decoration: none;
	}
	.pager a:hover {
		color: inherit;
	}
	.pager .t {
		font-weight: 600;
		line-height: 1.3;
		transition: color 0.15s ease;
	}
	.pager a:hover .t {
		color: var(--accent);
	}
	.pager .next {
		text-align: right;
		grid-column: 2;
	}
	@media (max-width: 34rem) {
		.pager {
			grid-template-columns: 1fr;
		}
		.pager .next {
			grid-column: 1;
		}
	}
</style>
